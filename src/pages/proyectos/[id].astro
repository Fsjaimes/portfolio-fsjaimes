---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos', ({ data }) => !data.borrador);
  return proyectos.map((proyecto) => ({ params: { id: proyecto.id }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<Base titulo={`${proyecto.data.titulo} | Frank Jaimes`} descripcion={proyecto.data.resumen}>
  <article class="py-12">
    <a href="/#proyectos" class="text-sm text-neutral-500 hover:underline">← Proyectos</a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">{proyecto.data.titulo}</h1>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">{proyecto.data.resumen}</p>
    <p class="mt-3 text-sm text-neutral-500">
      {proyecto.data.rol} · {[...proyecto.data.agentes, ...proyecto.data.stack].join(' · ')}
    </p>
    <div class="contenido mt-8">
      <Content />
    </div>
  </article>
</Base>
